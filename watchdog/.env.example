# Renombrá este archivo a ".env" (dentro de watchdog/) y completá los valores

# Ruta al archivo donde el script vigilado escribe su última fecha/hora
HEARTBEAT_FILE=last_run.txt

# Horas sin cambios antes de disparar la alerta
THRESHOLD_HOURS=5

# Cada cuántos minutos revisa el archivo
CHECK_INTERVAL_MIN=10

# Correo Gmail que envía el aviso (ver instrucciones en monitor.py)
EMAIL_FROM=tucuenta@gmail.com
EMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_TO=tucuenta@gmail.com

# Datos de CallMeBot (opcional, WhatsApp — ver instrucciones en monitor.py)
CALLMEBOT_PHONE=+18095551234
CALLMEBOT_APIKEY=XXXXXX
